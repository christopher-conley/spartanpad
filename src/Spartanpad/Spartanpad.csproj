<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Spartanpad</AssemblyName>
    <RootNamespace>Spartanpad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- One native executable per platform. No RuntimeIdentifier here: `dotnet build` and the tests
         target the host, and publish passes -r linux-x64 or -r win-x64. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- No native debug info in Release: nothing that ships uses it (build.sh deletes the .pdb and
         .dbg anyway), and lld-link 22.1.8's PDB writer segfaults on this program's object file
         (exit code 139 in the win-x64 publish, since the editor control came in; the same link
         without /DEBUG succeeds). Stack traces keep their method names: that is ILC's own metadata. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The xwin package defaults to caching the Windows SDK sysroot inside its own NuGet folder,
         and that splat contains a self-referencing symlink NuGet restore walks into. -->
    <XWinCache Condition="'$(XWinCache)' == ''">$(HOME)/.cache/xwin/</XWinCache>
    <!-- The icon resource of the Windows executable: Explorer, the taskbar and the Sandbox shortcut
         show it. Made from the 512 drawing with Pillow (PNG-compressed entries, 16 to 256 px):
         python3 -c "from PIL import Image; Image.open('spartanpad_512x512.png').convert('RGBA').save('spartanpad.ico', sizes=[(s, s) for s in (256, 128, 64, 48, 32, 24, 16)])"
         Linux takes the icon from the window and the menu entry instead (Icons.cs, DesktopEntry). -->
    <ApplicationIcon>res/spartanpad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- The editor control: lays out only the visible lines, so a file is limited by memory, not
         by layout time (the Avalonia TextBox took about a second per megabyte). -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- Lets `dotnet publish -r win-x64` link on Linux with lld-link and an xwin sysroot. Only
         active for win-* RIDs on a non-Windows host. -->
    <PackageReference Include="PublishAotCrossXWin" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Spartanpad.Core/Spartanpad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- The icon at the sizes a Linux icon theme takes, read back by Icons.cs; the 512 is also the
         source of the .ico above. -->
    <EmbeddedResource Include="res/spartanpad_512x512.png" LogicalName="icons/512.png" />
    <EmbeddedResource Include="res/spartanpad_256x256.png" LogicalName="icons/256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The headless UI tests reach the named controls. -->
    <InternalsVisibleTo Include="Spartanpad.Tests" />
  </ItemGroup>

</Project>
