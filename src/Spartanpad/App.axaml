<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spartanpad.App"
             Name="Spartanpad">
  <Application.Styles>
    <FluentTheme />
    <!-- AvaloniaEdit's control templates. Written in XAML so the include is resolved at compile
         time; the code form loads at run time and does not survive NativeAOT trimming. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>
</Application>
