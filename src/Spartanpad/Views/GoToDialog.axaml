<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spartanpad.Views.GoToDialog"
        Title="Go To Line"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="12" Width="300" Spacing="8">
    <TextBlock Text="Line number:" />
    <TextBox Name="LineNumber" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Name="GoToButton" Content="Go To" MinWidth="88" IsDefault="True" Click="OnGoTo" />
      <Button Content="Cancel" MinWidth="88" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
